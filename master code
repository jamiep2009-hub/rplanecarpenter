<!doctype html>

<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Rplane Carpenter Norwich | Carpenter in Norwich</title>
<meta name="description" content="Rplane Carpenter in Norwich. Kitchens, doors, flooring and custom woodwork."/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<style>
:root{
  --ink:#0e0b08;--ink2:#1c1610;--ink3:#2a2018;
  --warm:#f5f0e8;--cream:#faf7f2;
  --gold:#c4873d;--gold2:#a96d27;--gold3:#e8c89a;
  --muted:#7a6f62;--line:#e0d8cc;
  --r:12px;--R:20px;
  --nav-h:80px;
  --ease:cubic-bezier(.22,.68,0,1.2);
  --ease2:cubic-bezier(.4,0,.2,1);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:var(--nav-h);-webkit-text-size-adjust:100%}
@media(prefers-reduced-motion:reduce){*{animation-duration:.001ms!important;transition-duration:.001ms!important}}
body{font-family:"DM Sans",system-ui,sans-serif;background:var(--cream);color:var(--ink2);line-height:1.65;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
::selection{background:var(--gold);color:#fff}

}

/* ── SCROLL PROGRESS ───────────────────────────────── */
#spb{position:fixed;top:0;left:0;right:0;height:2px;z-index:200;pointer-events:none}
#spb span{display:block;height:100%;width:0;background:linear-gradient(90deg,var(–gold2),var(–gold),#f0d080);box-shadow:0 0 10px rgba(196,135,61,.5);transition:width .1s linear}

/* ── NAV ────────────────────────────────────────────── */
.nav{
position:fixed;top:0;left:0;right:0;z-index:100;height:var(–nav-h);
display:flex;align-items:center;
will-change:transform;transition:transform .35s var(–ease2);
}
.nav::before{
content:””;position:absolute;inset:0;
background:rgba(14,11,8,.88);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
border-bottom:1px solid rgba(255,255,255,.05);
opacity:0;transition:opacity .3s var(–ease2);will-change:opacity;
}
.nav.scrolled::before{opacity:1}
.nav.hidden{transform:translateY(-100%)}
.nav-inner{position:relative;max-width:1400px;margin:0 auto;padding:0 32px;width:100%;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{display:flex;align-items:center;gap:14px;transition:opacity .2s}
.brand:hover{opacity:.88}
.brand img{height:52px;width:auto;filter:brightness(0) invert(1);transition:height .3s}
.nav.scrolled .brand img{height:44px}
.brand-text{display:flex;flex-direction:column;gap:2px}
.brand-name{font-family:“Cormorant Garamond”,serif;font-size:1rem;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:#fff;line-height:1}
.brand-rule{width:100%;height:1px;background:linear-gradient(90deg,var(–gold),transparent);margin:4px 0;opacity:.7}
.brand-tag{font-size:.58rem;font-weight:400;letter-spacing:.22em;text-transform:uppercase;color:rgba(232,200,154,.7);line-height:1}
.nav-links{display:flex;align-items:center;gap:2px}
.nav-links a{padding:10px 14px;border-radius:8px;font-size:.8rem;font-weight:500;letter-spacing:.04em;color:rgba(255,255,255,.78);transition:color .2s,background .2s}
.nav-links a:hover{color:#fff;background:rgba(255,255,255,.07)}
.nav-links a.active{color:var(–gold)}
.nav-cta{padding:11px 22px;border-radius:999px;background:var(–gold);color:#fff;font-size:.8rem;font-weight:600;letter-spacing:.06em;box-shadow:0 4px 18px rgba(196,135,61,.4);transition:transform .25s var(–ease),box-shadow .25s,background .2s}
.nav-cta:hover{background:var(–gold2);transform:translateY(-2px);box-shadow:0 8px 26px rgba(196,135,61,.5)}
.menu-btn{display:none;background:rgba(255,255,255,.08);border:0;color:#fff;padding:10px;border-radius:9px;cursor:pointer}
.menu-btn svg{width:22px;height:22px;display:block}
@media(max-width:920px){
.nav-links{position:absolute;top:calc(100% + 8px);left:16px;right:16px;flex-direction:column;align-items:stretch;gap:4px;background:rgba(14,11,8,.96);backdrop-filter:blur(20px);padding:10px;border-radius:16px;border:1px solid rgba(255,255,255,.07);transform:translateY(-8px) scale(.97);opacity:0;pointer-events:none;transition:opacity .25s,transform .25s var(–ease)}
.nav-links.open{opacity:1;transform:none;pointer-events:auto}
.nav-links a{padding:13px 16px;border-radius:10px}
.nav-cta{display:none}
.menu-btn{display:inline-flex;align-items:center;justify-content:center}
}

/* ── HERO ───────────────────────────────────────────── */
.hero{position:relative;min-height:100vh;min-height:100svh;display:flex;align-items:center;overflow:hidden;color:#fff;isolation:isolate}
#hero-canvas{position:absolute;inset:0;z-index:0;pointer-events:none}
.hero-bg{
position:absolute;inset:-8%;z-index:-1;
background:url(‘data:image/jpeg;base64,’) center/cover no-repeat;
animation:heroZoom 28s ease-in-out infinite alternate;
will-change:transform;
}
@keyframes heroZoom{from{transform:scale(1)}to{transform:scale(1.08)}}
.hero-overlay{
position:absolute;inset:0;z-index:-1;
background:
linear-gradient(110deg,rgba(14,11,8,.9) 0%,rgba(14,11,8,.65) 45%,rgba(14,11,8,.2) 100%),
radial-gradient(ellipse at 12% 40%,rgba(196,135,61,.18) 0%,transparent 55%);
}
.hero-content{position:relative;z-index:1;max-width:1400px;margin:0 auto;padding:calc(var(–nav-h) + 70px) 32px 140px;width:100%}
.hero-eyebrow{
display:inline-flex;align-items:center;gap:12px;margin-bottom:28px;
font-size:.7rem;font-weight:500;letter-spacing:.3em;text-transform:uppercase;
color:var(–gold3);
opacity:0;animation:heroUp .9s var(–ease) .3s both;
}
.hero-eyebrow::before{content:””;width:32px;height:1px;background:var(–gold);border-radius:1px}
.hero h1{
font-family:“Cormorant Garamond”,serif;
font-size:clamp(3rem,7.5vw,6.8rem);font-weight:300;
line-height:1.02;letter-spacing:-.01em;max-width:900px;
opacity:0;animation:heroUp 1s var(–ease) .45s both;
}
.hero h1 em{font-style:italic;color:var(–gold3);font-weight:300}
.hero-sub{
margin-top:28px;max-width:500px;
font-size:1.05rem;font-weight:300;color:rgba(255,255,255,.75);line-height:1.75;
opacity:0;animation:heroUp .9s var(–ease) .62s both;
}
.hero-actions{
margin-top:48px;display:flex;gap:16px;flex-wrap:wrap;
opacity:0;animation:heroUp .9s var(–ease) .78s both;
}
@keyframes heroUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:none}}

/* Buttons */
.btn{display:inline-flex;align-items:center;gap:11px;padding:17px 32px;border-radius:999px;font-weight:500;font-size:.9rem;letter-spacing:.04em;cursor:pointer;border:0;font-family:inherit;position:relative;overflow:hidden;transition:transform .3s var(–ease),box-shadow .3s var(–ease)}
.btn::after{content:””;position:absolute;inset:0;background:linear-gradient(120deg,transparent 40%,rgba(255,255,255,.2),transparent 60%);transform:translateX(-100%);transition:transform .6s var(–ease2)}
.btn:hover::after{transform:translateX(100%)}
.btn svg{width:17px;height:17px;transition:transform .3s var(–ease)}
.btn:hover svg{transform:translateX(5px)}
.btn-primary{background:var(–gold);color:#fff;box-shadow:0 12px 32px rgba(196,135,61,.45)}
.btn-primary:hover{transform:translateY(-3px);box-shadow:0 20px 44px rgba(196,135,61,.58)}
.btn-outline{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.28);backdrop-filter:blur(6px)}
.btn-outline:hover{background:rgba(255,255,255,.1);transform:translateY(-3px)}
.btn-dark{background:var(–ink);color:#fff;box-shadow:0 12px 28px rgba(14,11,8,.3)}
.btn-dark:hover{transform:translateY(-3px);box-shadow:0 20px 40px rgba(14,11,8,.4)}

/* Hero stats */
.hero-stats{
position:absolute;bottom:0;left:0;right:0;z-index:1;
border-top:1px solid rgba(255,255,255,.08);
background:rgba(14,11,8,.55);backdrop-filter:blur(14px);
opacity:0;animation:heroUp .9s var(–ease) 1s both;
}
.hero-stats-inner{max-width:1400px;margin:0 auto;padding:22px 32px;display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.stat{display:flex;align-items:center;gap:14px}
.stat-num{font-family:“Cormorant Garamond”,serif;font-size:2rem;font-weight:500;color:#fff;line-height:1;letter-spacing:-.01em}
.stat-label{font-size:.68rem;text-transform:uppercase;letter-spacing:.14em;color:rgba(255,255,255,.6);margin-top:3px;font-weight:400}

/* ── SHARED ─────────────────────────────────────────── */
section{padding:clamp(90px,11vw,150px) 0;position:relative}
.wrap{max-width:1400px;margin:0 auto;padding:0 32px}
.section-head{margin-bottom:72px}
.section-head.center{text-align:center;display:flex;flex-direction:column;align-items:center}
.eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:.68rem;font-weight:500;letter-spacing:.28em;text-transform:uppercase;color:var(–gold2);margin-bottom:16px}
.eyebrow::before{content:””;width:28px;height:1px;background:var(–gold);border-radius:1px;transition:width .6s var(–ease2)}.eyebrow.in::before{width:28px}
h2{font-family:“Cormorant Garamond”,serif;font-size:clamp(2.2rem,4.2vw,3.6rem);font-weight:400;letter-spacing:-.01em;line-height:1.08;color:var(–ink)}
h2 em{font-style:italic;color:var(–gold2)}
.lead{color:var(–muted);font-size:1rem;font-weight:300;line-height:1.8;max-width:580px;margin-top:18px}
.section-head.center .lead{text-align:center;margin-left:auto;margin-right:auto}

/* ── SCROLL ANIMATIONS ─────────────────────────────── */
.reveal{opacity:0;transform:translateY(50px);transition:opacity .85s ease,transform .85s ease}
.reveal.in{opacity:1;transform:translateY(0)}

.reveal-left{opacity:0;transform:translateX(-50px);transition:opacity .85s ease,transform .85s ease}
.reveal-left.in{opacity:1;transform:translateX(0)}

.reveal-right{opacity:0;transform:translateX(50px);transition:opacity .85s ease,transform .85s ease}
.reveal-right.in{opacity:1;transform:translateX(0)}

.reveal-scale{opacity:0;transform:scale(.93);transition:opacity .7s ease,transform .7s ease}
.reveal-scale.in{opacity:1;transform:scale(1)}

.reveal-blur{opacity:0;filter:blur(10px);transform:translateY(20px);transition:opacity .9s ease,filter .9s ease,transform .9s ease}
.reveal-blur.in{opacity:1;filter:blur(0);transform:translateY(0)}

.reveal-rotate{opacity:0;transform:perspective(900px) rotateX(22deg) translateY(30px);transition:opacity .8s ease,transform .8s ease}
.reveal-rotate.in{opacity:1;transform:perspective(900px) rotateX(0) translateY(0)}

/* Stagger — children cascade in */
.stagger-item{opacity:0;transform:translateY(32px);transition:opacity .7s ease,transform .7s ease}
.stagger-item.in{opacity:1;transform:translateY(0)}

/* Counter pop */
@keyframes numPop{0%{transform:scale(1)}50%{transform:scale(1.18)}100%{transform:scale(1)}}
.num-pop{animation:numPop .4s ease}

/* Parallax containers */
.parallax-img{will-change:transform;transition:transform .08s linear}

/* Gallery tile hover magnetic */
.g-tile{transition:transform .45s ease,box-shadow .45s ease}

/* Solo card hover */
.solo-card{transition:background .35s ease,transform .35s ease,box-shadow .35s ease}
.solo-card:hover{transform:translateY(-5px);box-shadow:0 20px 50px rgba(0,0,0,.4)}

/* Nav underline draw */
.nav-links a{position:relative}
.nav-links a::after{content:””;position:absolute;bottom:-2px;left:0;width:0;height:1px;background:var(–gold);transition:width .3s ease}
.nav-links a:hover::after,.nav-links a.active::after{width:100%}

/* Service card dark fill reveal */
.service-card{transition:background .35s ease}

/* ── MARQUEE ────────────────────────────────────────── */
.marquee-section{padding:24px 0;background:var(–ink);border-top:1px solid rgba(255,255,255,.05);border-bottom:1px solid rgba(255,255,255,.05);overflow:hidden}
.marquee-track{display:flex;gap:0;white-space:nowrap;animation:marquee 28s linear infinite}
.marquee-track:hover{animation-play-state:paused}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.marquee-item{display:inline-flex;align-items:center;gap:16px;padding:0 32px;font-family:“Cormorant Garamond”,serif;font-size:1.15rem;font-weight:400;color:rgba(255,255,255,.5);letter-spacing:.04em;white-space:nowrap}
.marquee-dot{width:4px;height:4px;border-radius:50%;background:var(–gold);flex-shrink:0;opacity:.6}

/* ── SERVICES ───────────────────────────────────────── */
.services{background:var(–cream)}
.services-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(–line)}
.service-card{
background:var(–cream);padding:44px 36px;
position:relative;overflow:hidden;
transition:background .35s var(–ease2);
cursor:pointer;
}
.service-card::before{
content:””;position:absolute;inset:0;
background:var(–ink);transform:scaleY(0);transform-origin:bottom;
transition:transform .5s var(–ease2);
z-index:0;
}
.service-card:hover{background:var(–cream)}
.service-card:hover::before{transform:scaleY(1)}
.service-card>*{position:relative;z-index:1;transition:color .35s var(–ease2)}
.service-card:hover .svc-num{color:rgba(255,255,255,.2)}
.service-card:hover .svc-icon{color:var(–gold)}
.service-card:hover h3{color:#fff}
.service-card:hover p{color:rgba(255,255,255,.6)}
.service-card:hover .svc-link{color:var(–gold3)}
.svc-num{font-family:“Cormorant Garamond”,serif;font-size:3.5rem;font-weight:300;color:rgba(14,11,8,.07);line-height:1;margin-bottom:24px;letter-spacing:-.02em;transition:color .35s}
.svc-icon{color:var(–gold2);margin-bottom:18px;transition:color .35s,transform .4s var(–ease)}
.svc-icon svg{width:32px;height:32px;stroke-width:1.3}
.service-card:hover .svc-icon{transform:scale(1.1)}
.service-card h3{font-family:“Cormorant Garamond”,serif;font-size:1.55rem;font-weight:400;letter-spacing:.01em;color:var(–ink);margin-bottom:12px;line-height:1.2;transition:color .35s}
.service-card p{color:var(–muted);font-size:.9rem;font-weight:300;line-height:1.75;margin:0;transition:color .35s}
.svc-link{margin-top:24px;display:inline-flex;align-items:center;gap:8px;font-size:.72rem;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(–gold2);transition:color .35s,gap .25s}
.svc-link svg{width:14px;height:14px;stroke-width:2;transition:transform .25s var(–ease)}
.service-card:hover .svc-link{gap:14px}
.service-card:hover .svc-link svg{transform:translateX(4px)}
@media(max-width:1000px){.services-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.services-grid{grid-template-columns:1fr}}

/* ── WHY SOLE TRADER ───────────────────────────────── */
.solo{background:var(–ink);color:rgba(255,255,255,.78)}
.solo h2{color:#fff}
.solo .lead{color:rgba(255,255,255,.42)}
.solo-grid{
display:grid;grid-template-columns:repeat(3,1fr);
gap:1px;background:rgba(255,255,255,.06);
margin-top:72px;
}
.solo-card{
padding:48px 36px;background:var(–ink);
position:relative;overflow:hidden;
transition:background .35s var(–ease2);
}
.solo-card::before{
content:””;position:absolute;inset:0;
background:rgba(196,135,61,.06);
opacity:0;transition:opacity .35s;
}
.solo-card:hover{background:#160f08}
.solo-card:hover::before{opacity:1}
.solo-card-num{
font-family:“Cormorant Garamond”,serif;
font-size:3.8rem;font-weight:300;
color:rgba(196,135,61,.15);
line-height:1;margin-bottom:22px;
letter-spacing:-.02em;
}
.solo-card h4{
font-family:“Cormorant Garamond”,serif;
font-size:1.35rem;font-weight:400;
color:#fff;margin-bottom:12px;letter-spacing:.01em;
}
.solo-card p{
font-size:.9rem;font-weight:300;
line-height:1.8;color:rgba(255,255,255,.45);
margin:0;
}
@media(max-width:880px){.solo-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:480px){.solo-grid{grid-template-columns:1fr}}

/* ── GALLERY ─────────────────────────────────────────── */
.gallery{background:var(–warm)}
.gallery-grid{columns:2;column-gap:14px}
.g-tile{break-inside:avoid;margin-bottom:14px;position:relative;border-radius:var(–R);overflow:hidden;background:var(–ink);cursor:pointer;box-shadow:0 4px 20px rgba(14,11,8,.1);display:block;transition:transform .45s var(–ease2),box-shadow .45s var(–ease2)}
.g-tile img{width:100%;height:auto;display:block;filter:brightness(.88);transition:filter .5s,transform .7s var(–ease2)}
.g-tile::after{content:””;position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(14,11,8,.82));opacity:.45;transition:opacity .4s;pointer-events:none}
.g-tile:hover{transform:translateY(-5px);box-shadow:0 22px 55px rgba(14,11,8,.22)}
.g-tile:hover img{filter:brightness(1);transform:scale(1.03)}
.g-tile:hover::after{opacity:1}
.g-tile-full{column-span:all;margin-bottom:14px}
.g-label{position:absolute;left:24px;bottom:22px;right:24px;z-index:2;transform:translateY(10px);opacity:0;transition:transform .38s var(–ease2),opacity .32s}
.g-tile:hover .g-label{transform:none;opacity:1}
.g-label-tag{font-size:.62rem;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:var(–gold3);margin-bottom:5px;display:block}
.g-label-title{font-family:“Cormorant Garamond”,serif;font-size:1.15rem;font-weight:400;color:#fff;line-height:1.2;display:block}
@media(max-width:700px){.gallery-grid{columns:1}}

/* ── ABOUT ───────────────────────────────────────────── */
.about{background:var(–cream)}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:center}
.about-copy p{color:var(–muted);font-size:.97rem;font-weight:300;line-height:1.85;margin-top:18px}
.about-copy .lead-quote{
font-family:“Cormorant Garamond”,serif;
font-size:clamp(1.4rem,2.4vw,1.9rem);font-weight:300;font-style:italic;
color:var(–ink);line-height:1.45;
border-left:2px solid var(–gold);
padding-left:24px;margin:32px 0;
}
.about-stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:48px;padding-top:40px;border-top:1px solid var(–line)}
.about-stat strong{display:block;font-family:“Cormorant Garamond”,serif;font-size:2.8rem;font-weight:400;color:var(–gold2);letter-spacing:-.02em;line-height:1}
.about-stat span{display:block;margin-top:8px;font-size:.68rem;font-weight:500;text-transform:uppercase;letter-spacing:.16em;color:var(–muted)}
.about-img-wrap{position:relative;aspect-ratio:4/5;border-radius:var(–R);overflow:hidden;box-shadow:0 40px 90px rgba(14,11,8,.25)}
.about-img-wrap img{width:100%;height:100%;object-fit:cover;transition:transform 1.2s var(–ease2)}
.about-img-wrap:hover img{transform:scale(1.03)}
.about-badge{position:absolute;left:-28px;bottom:44px;background:var(–ink);color:#fff;padding:22px 28px;border-radius:var(–r);box-shadow:0 24px 54px rgba(0,0,0,.36);border:1px solid rgba(255,255,255,.06)}
.about-badge strong{display:block;font-family:“Cormorant Garamond”,serif;font-size:2.2rem;font-weight:400;color:var(–gold);line-height:1}
.about-badge span{display:block;font-size:.64rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.45);margin-top:7px;font-weight:400}
@media(max-width:920px){.about-grid{grid-template-columns:1fr;gap:50px}.about-img-wrap{aspect-ratio:1/1;max-width:540px;margin:0 auto}}

/* ── FILTER TILE SCROLL REVEAL ─────────────────────── */
.filter-tile{position:relative;border-radius:var(–R,20px);overflow:hidden;background:var(–ink,#1a1410);cursor:pointer;box-shadow:0 4px 20px rgba(0,0,0,.1);}

/* filter section below */

/* ── FILTER SHOWCASE ───────────────────────────────── */
.filter-section{background:var(–ink);padding:clamp(80px,10vw,130px) 0}
.filter-section h2{color:#fff}
.filter-section .lead{color:rgba(255,255,255,.42)}
.filter-tabs{
display:flex;flex-wrap:wrap;gap:10px;
margin:48px 0 44px;
}
.filter-tab{
padding:11px 22px;border-radius:999px;
border:1.5px solid rgba(255,255,255,.12);
background:transparent;color:rgba(255,255,255,.55);
font:500 .8rem/1 “DM Sans”,sans-serif;letter-spacing:.08em;
cursor:pointer;transition:all .25s var(–ease2);
}
.filter-tab:hover{border-color:rgba(196,135,61,.5);color:#fff}
.filter-tab.active{
background:var(–gold);border-color:var(–gold);
color:#fff;box-shadow:0 6px 20px rgba(196,135,61,.4);
}
.filter-grid{
display:grid;grid-template-columns:repeat(3,1fr);
gap:16px;min-height:320px;
}
.filter-tile{
position:relative;border-radius:var(–R);overflow:hidden;
background:#1a1410;cursor:pointer;
