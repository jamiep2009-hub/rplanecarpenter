<script>
document.addEventListener('DOMContentLoaded', () => {



// ── SCROLL PROGRESS BAR ───────────────────────────
const progressBar = document.getElementById('spb-bar');
if (progressBar) {
  window.addEventListener('scroll', () => {
    const d = document.documentElement;
    const pct = d.scrollTop / (d.scrollHeight - d.clientHeight) * 100;
    progressBar.style.width = Math.min(pct, 100) + '%';
  }, { passive: true });
}

// ── CUSTOM CURSOR (desktop only) ──────────────────
const curDot  = document.getElementById('cursor');
const curRing = document.getElementById('cursor-ring');
if (curDot && window.matchMedia('(hover:hover) and (pointer:fine)').matches) {
  let mx = 0, my = 0, rx = 0, ry = 0;
  document.addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; });
  const moveCursor = () => {
    curDot.style.transform = `translate(${mx - 5}px,${my - 5}px)`;
    rx += (mx - rx) * .14; ry += (my - ry) * .14;
    if (curRing) curRing.style.transform = `translate(${rx - 18}px,${ry - 18}px)`;
    requestAnimationFrame(moveCursor);
  };
  moveCursor();
  document.querySelectorAll('a,button,.service-card,.g-tile').forEach(el => {
    el.addEventListener('mouseenter', () => document.body.classList.add('cursor-hover'));
    el.addEventListener('mouseleave', () => document.body.classList.remove('cursor-hover'));
  });
  document.addEventListener('mousedown', () => document.body.classList.add('cursor-active'));
  document.addEventListener('mouseup',   () => document.body.classList.remove('cursor-active'));
}

// ── NAV ───────────────────────────────────────────
const navEl    = document.getElementById('nav');
const navLinks = document.getElementById('navLinks');
const menuBtn  = document.getElementById('menuBtn');
let lastScroll = 0, navTick = false;

window.addEventListener('scroll', () => {
  if (navTick) return;
  navTick = true;
  requestAnimationFrame(() => {
    const y = window.scrollY;
    if (navEl) {
      navEl.classList.toggle('scrolled', y > 20);
      navEl.classList.toggle('hidden',   y > 300 && y > lastScroll + 8);
      if (y < lastScroll - 8 || y < 80) navEl.classList.remove('hidden');
    }
    lastScroll = y;
    navTick = false;
  });
}, { passive: true });

if (menuBtn && navLinks) {
  menuBtn.addEventListener('click', () => {
    const open = navLinks.classList.toggle('open');
    menuBtn.setAttribute('aria-expanded', String(open));
  });
  navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    navLinks.classList.remove('open');
    menuBtn.setAttribute('aria-expanded', 'false');
  }));
}

// ── ACTIVE NAV LINK ────────────────────────────────
const navSections = ['home','services','work','about','contact']
  .map(id => document.getElementById(id)).filter(Boolean);
const updateActiveNav = () => {
  const scrollY = window.scrollY + 140;
  let current = navSections[0]?.id;
  navSections.forEach(s => { if (s.offsetTop <= scrollY) current = s.id; });
  if (navLinks) navLinks.querySelectorAll('a').forEach(a =>
    a.classList.toggle('active', a.getAttribute('href') === '#' + current)
  );
};
window.addEventListener('scroll', updateActiveNav, { passive: true });
updateActiveNav();

// ── SCROLL REVEAL ──────────────────────────────────
const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.classList.add('in');
      revealObserver.unobserve(e.target);
    }
  });
}, { threshold: 0.1 });

document.querySelectorAll(
  '.reveal,.reveal-left,.reveal-right,.reveal-scale,.reveal-blur,.reveal-rotate'
).forEach(el => revealObserver.observe(el));


// Fade-up text observer
const fadeUpObs = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.classList.add('in');
      fadeUpObs.unobserve(e.target);
    }
  });
}, { threshold: 0.12 });
document.querySelectorAll('.text-stagger, .about-copy, .fade-up, .reveal-left, .reveal-right').forEach(el => fadeUpObs.observe(el));

// ── STAGGER GROUPS ─────────────────────────────────
document.querySelectorAll('.stagger').forEach(parent => {
  Array.from(parent.children).forEach((child, i) => {
    child.style.opacity = '0';
    child.style.transform = 'translateY(36px)';
    child.style.transition = `opacity .7s ${(i * 0.11).toFixed(2)}s ease, transform .7s ${(i * 0.11).toFixed(2)}s ease`;
  });
  const staggerObs = new IntersectionObserver(([entry]) => {
    if (entry.isIntersecting) {
      Array.from(parent.children).forEach(child => {
        child.style.opacity = '1';
        child.style.transform = 'translateY(0)';
      });
      staggerObs.unobserve(parent);
    }
  }, { threshold: 0.08 });
  staggerObs.observe(parent);
});

// ── SOLO CARDS STAGGER ─────────────────────────────
const soloGrid = document.getElementById('soloGrid');
if (soloGrid) {
  const soloCards = soloGrid.querySelectorAll('.solo-card');
  soloCards.forEach((c, i) => {
    c.style.opacity = '0';
    c.style.transform = 'translateY(40px)';
    c.style.transition = `opacity .75s ${(i * 0.1).toFixed(2)}s ease, transform .75s ${(i * 0.1).toFixed(2)}s ease, background .35s ease, box-shadow .35s ease`;
  });
  const soloObs = new IntersectionObserver(([entry]) => {
    if (entry.isIntersecting) {
      soloCards.forEach(c => { c.style.opacity = '1'; c.style.transform = 'none'; });
      soloObs.unobserve(soloGrid);
    }
  }, { threshold: 0.06 });
  soloObs.observe(soloGrid);
}

// ── GALLERY STAGGER ────────────────────────────────
const galleryGrid = document.getElementById('galleryGrid');
if (galleryGrid) {
  const galleryTilesAnim = galleryGrid.querySelectorAll('.g-tile');
  galleryTilesAnim.forEach((t, i) => {
    t.style.opacity = '0';
    t.style.transform = 'translateY(40px) scale(.97)';
    t.style.transition = `opacity .65s ${(i * 0.07).toFixed(2)}s ease, transform .65s ${(i * 0.07).toFixed(2)}s ease, box-shadow .45s ease`;
  });
  const galObs = new IntersectionObserver(([entry]) => {
    if (entry.isIntersecting) {
      galleryTilesAnim.forEach(t => { t.style.opacity = '1'; t.style.transform = 'scale(1) translateY(0)'; });
      galObs.unobserve(galleryGrid);
    }
  }, { threshold: 0.04 });
  galObs.observe(galleryGrid);
}

// ── COUNTERS ───────────────────────────────────────
const counterObs = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (!entry.isIntersecting) return;
    const el = entry.target;
    const target = parseInt(el.dataset.target, 10);
    const suffix = el.dataset.suffix || '';
    if (isNaN(target)) return;
    const duration = target > 500 ? 1800 : 1200;
    const t0 = performance.now();
    const countUp = (now) => {
      const progress = Math.min((now - t0) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.round(target * eased) + suffix;
      if (progress < 1) requestAnimationFrame(countUp);
      else { el.textContent = target + suffix; el.classList.add('num-pop'); }
    };
    requestAnimationFrame(countUp);
    counterObs.unobserve(el);
  });
}, { threshold: 0.8 });
document.querySelectorAll('[data-target]').forEach(el => counterObs.observe(el));

// ── PARALLAX ──────────────────────────────────────
const heroBgEl = document.querySelector('.hero-bg');
const aboutImgEl = document.querySelector('.about-img-wrap img');
window.addEventListener('scroll', () => {
  const scrollY = window.scrollY;
  if (heroBgEl && scrollY < window.innerHeight * 1.4) {
    heroBgEl.style.transform = `translateY(${scrollY * 0.25}px)`;
  }
  if (aboutImgEl) {
    const rect = aboutImgEl.closest('.about-img-wrap').getBoundingClientRect();
    const offset = (rect.top + rect.height / 2 - window.innerHeight / 2) * 0.08;
    aboutImgEl.style.transform = `translateY(${offset}px)`;
  }
}, { passive: true });

// ── MAGNETIC GALLERY HOVER ────────────────────────
if (window.matchMedia('(hover:hover) and (pointer:fine)').matches) {
  document.querySelectorAll('.g-tile').forEach(tile => {
    let rafId;
    tile.addEventListener('mousemove', e => {
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => {
        const rect = tile.getBoundingClientRect();
        const dx = (e.clientX - rect.left - rect.width  / 2) / (rect.width  / 2);
        const dy = (e.clientY - rect.top  - rect.height / 2) / (rect.height / 2);
        tile.style.transform = `translateY(-6px) rotate(${dx * 1.8}deg) scale(1.02)`;
        tile.style.boxShadow = `${(-dx * 8).toFixed(1)}px ${(Math.abs(dy) * 6 + 16).toFixed(1)}px 40px rgba(0,0,0,.35)`;
      });
    });
    tile.addEventListener('mouseleave', () => {
      cancelAnimationFrame(rafId);
      tile.style.transform = '';
      tile.style.boxShadow = '';
    });
  });
}

// ── HERO CANVAS PARTICLES ─────────────────────────
const heroCanvas = document.getElementById('hero-canvas');
if (heroCanvas) {
  const ctx = heroCanvas.getContext('2d');
  let cw, ch;
  const resizeCanvas = () => {
    cw = heroCanvas.width  = heroCanvas.offsetWidth;
    ch = heroCanvas.height = heroCanvas.offsetHeight;
  };
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas, { passive: true });
  const particles = Array.from({ length: 45 }, () => ({
    x:  Math.random() * 1600,
    y:  Math.random() * 900,
    vx: (Math.random() - .5) * .2,
    vy: -Math.random() * .15 - .05,
    r:  Math.random() * 1.6 + .3,
    a:  Math.random() * .3 + .08,
    h:  28 + Math.random() * 18,
  }));
  const drawParticles = () => {
    ctx.clearRect(0, 0, cw, ch);
    particles.forEach(p => {
      p.x += p.vx; p.y += p.vy;
      if (p.y < -4) p.y = ch + 4;
      if (p.x < -4) p.x = cw + 4;
      if (p.x > cw + 4) p.x = -4;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = `hsla(${p.h},70%,65%,${p.a})`;
      ctx.fill();
    });
    requestAnimationFrame(drawParticles);
  };
  drawParticles();
}

// ── FILTER GALLERY ──────────────────────────────────
const filterGrid  = document.getElementById('filterGrid');
const filterTabs  = document.getElementById('filterTabs');
const filterCount = document.getElementById('filterCount');

if (filterGrid && filterTabs) {

  // Tiles are already in the HTML with data-filter attributes
  const allTiles = Array.from(filterGrid.querySelectorAll('.filter-tile'));

  // Animate tiles in as they scroll into view
  const tileObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const i = allTiles.indexOf(e.target);
        e.target.style.transitionDelay = ((i % 3) * 0.08) + 's';
        e.target.style.opacity = '1';
        e.target.style.transform = 'translateY(0)';
        tileObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.06 });

  allTiles.forEach(t => {
    t.style.opacity = '0';
    t.style.transform = 'translateY(28px)';
    t.style.transition = 'opacity .6s ease, transform .6s ease, box-shadow .4s ease';
    tileObs.observe(t);
  });

  // Filter function
  const applyFilter = (active) => {
    let count = 0;
    allTiles.forEach(tile => {
      const show = active === 'all' || tile.dataset.filter === active;
      tile.style.display = show ? 'block' : 'none';
      if (show) count++;
    });
    if (filterCount) filterCount.textContent = 'Showing ' + count + ' project' + (count === 1 ? '' : 's');
  };

  // Tab clicks
  filterTabs.querySelectorAll('.filter-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      filterTabs.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      applyFilter(tab.dataset.filter);
    });
  });

  applyFilter('all');
}

// ── CONTACT FORM ──────────────────────────────────
const formBtn = document.getElementById('formBtn');
if (formBtn) {
  formBtn.addEventListener('click', () => {
    const fw      = formBtn.closest('.form-wrap');
    const name    = fw.querySelector('input[type=text]')?.value   || '';
    const phone   = fw.querySelector('input[type=tel]')?.value    || '';
    const email   = fw.querySelector('input[type=email]')?.value  || '';
    const project = fw.querySelector('select')?.value             || '';
    const msg     = fw.querySelector('textarea')?.value           || '';
    const sub  = encodeURIComponent('Carpentry enquiry \u2014 ' + name);
    const body = encodeURIComponent(
      'Name: ' + name + '\nPhone: ' + phone + '\nEmail: ' + email +
      '\nProject: ' + project + '\n\n' + msg
    );
    window.location.href = 'mailto:rplanecarpenter@hotmail.co.uk?subject=' + sub + '&body=' + body;
    formBtn.textContent = 'Opening your email app\u2026';
    setTimeout(() => { formBtn.textContent = 'Send message'; }, 4000);
  });
}

}); // end DOMContentLoaded
</script>

